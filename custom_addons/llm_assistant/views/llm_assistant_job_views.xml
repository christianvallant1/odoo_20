<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="llm_assistant_job_view_list" model="ir.ui.view">
        <field name="name">llm.assistant.job.view.list</field>
        <field name="model">llm.assistant.job</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="state == 'failed'" decoration-info="state == 'queued'">
                <field name="create_date" string="Asked On"/>
                <field name="user_id"/>
                <field name="step" string="Steps"/>
                <field name="state" widget="badge" decoration-info="state == 'queued'" decoration-success="state == 'done'" decoration-danger="state == 'failed'"/>
                <field name="error" optional="show"/>
            </list>
        </field>
    </record>

    <record id="llm_assistant_job_view_form" model="ir.ui.view">
        <field name="name">llm.assistant.job.view.form</field>
        <field name="model">llm.assistant.job</field>
        <field name="arch" type="xml">
            <form string="Answer" create="false" edit="false">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not error">
                        <field name="error"/>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="channel_id"/>
                        </group>
                        <group>
                            <field name="create_date" string="Asked On"/>
                            <field name="step" string="Steps"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Proposals" name="proposals">
                            <field name="proposal_ids"/>
                        </page>
                        <page string="Transcript" name="transcript">
                            <field name="transcript"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="llm_assistant_job_view_search" model="ir.ui.view">
        <field name="name">llm.assistant.job.view.search</field>
        <field name="model">llm.assistant.job</field>
        <field name="arch" type="xml">
            <search string="Answers">
                <field name="user_id"/>
                <filter string="Queued" name="filter_queued" domain="[('state', '=', 'queued')]"/>
                <filter string="Failed" name="filter_failed" domain="[('state', '=', 'failed')]"/>
            </search>
        </field>
    </record>

    <record id="llm_assistant_job_action" model="ir.actions.act_window">
        <field name="name">Answers</field>
        <field name="res_model">llm.assistant.job</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No answer yet</p>
            <p>Each answer of the AI Assistant in Discuss is logged here, with the full transcript of its tool calls.</p>
        </field>
    </record>

</odoo>
